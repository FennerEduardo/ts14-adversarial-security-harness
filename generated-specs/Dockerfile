# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (TypeScript · NestJS 11 + Prisma 6 (CommonJS)).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 3000; probes: liveness /health, readiness /health/ready.

FROM node:24-bookworm AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund --loglevel=error
COPY . .
# The Prisma client is generated at build time (the URL is only read by the CLI config, not used).
RUN DATABASE_URL=${DATABASE_URL:-postgresql://build:build@localhost:5432/build} npx prisma generate
RUN npm run build && npm prune --omit=dev

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/src/main.js"]
