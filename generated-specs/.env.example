# Environment Variables for cli-adversarial-security-harness
NODE_ENV=development
PORT=3000

# Database and message broker (read by the runtime kernel)
DATABASE_URL=mysql://dev_user:dev_password@localhost:3306/cli-adversarial-security-harness_db
AMQP_URL=amqp://dev_user:dev_password@localhost:5672

# Security & Authentication
JWT_SECRET=<YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS>
JWT_TTL_SECONDS=3600
BCRYPT_COST_FACTOR=12

# Serverless & Cloud Configuration
AWS_REGION=us-east-1
SERVERLESS_STAGE=dev
